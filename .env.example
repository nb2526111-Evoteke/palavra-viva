# TURSO_DATABASE_URL=https://seu-banco.turso.io
# TURSO_AUTH_TOKEN=seu-token-do-turso

# Uploads na Vercel Blob (criado automaticamente ao conectar o store)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
