# Copie este arquivo para .env e preencha os valores
ADMIN_EMAIL=seu-email@exemplo.com
ADMIN_PASSWORD=uma-senha-forte
ADMIN_NAME=Seu Nome
SESSION_SECRET=gere-uma-string-aleatoria-longa
SITE_URL=http://localhost:3000

